{
  "expo": {
    "name": "Trim",
    "slug": "workout-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trim-icon.png",
    "scheme": "scratchworkout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.marvinbeckmann.ScratchWorkout",
      "supportsTablet": false,
      "icon": "./assets/trim.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.marvinbeckmann.scratchworkout",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E0D",
          "image": "./assets/images/trim-splash.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0E0E0D",
            "image": "./assets/images/trim-splash-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.marvinbeckmann.ScratchWorkout.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.marvinbeckmann.ScratchWorkout"
        }
      ],
      "./plugins/with-quoted-bundle-script",
      "./plugins/with-quoted-pod-scripts",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Doto-Black.ttf",
            "./assets/fonts/IBMPlexMono-Medium.ttf",
            "./assets/fonts/IBMPlexMono-Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trim reads your workout plan from the screenshots you pick.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "88024391-8ffd-4a6d-923d-18c766972365"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/88024391-8ffd-4a6d-923d-18c766972365"
    }
  }
}
