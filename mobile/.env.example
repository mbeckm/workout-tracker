# Public SDK key for the iOS *Apple* app in RevenueCat. It starts with appl_
# Do not use the Test Store key (test_) — that is what Expo Go treats as web billing
# and it returns a credentials error.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# ExerciseDB — Expo Go may use OSS (default base below; non-commercial).
# Store builds must set the RapidAPI key before submit. Do not invent a key.
# EXPO_PUBLIC_EXERCISE_CATALOG_BASE_URL=https://oss.exercisedb.dev
# EXPO_PUBLIC_EXERCISEDB_RAPIDAPI_KEY=
# EXPO_PUBLIC_EXERCISEDB_RAPIDAPI_HOST=exercisedb.p.rapidapi.com
