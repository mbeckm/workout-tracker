# Public SDK key for the iOS *Apple* app in RevenueCat. It starts with appl_
# Do not use the Test Store key (test_) — that is what Expo Go treats as web billing
# and it returns a credentials error.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Exercise catalog. Production is local-only: the bundled first-party catalog plus the
# user's custom exercises, with no remote media and no remote search. eas.json pins both
# flags to "off" for the production profile; unset also means off.
#
# Remote media on any surface: "on" only with a licensed, self-hosted source.
# EXPO_PUBLIC_EXERCISE_MEDIA=off
# EXPO_PUBLIC_EXERCISE_MEDIA_BASE_URL=
#
# Remote search: off | oss | rapidapi
# - oss: non-commercial ExerciseDB OSS host, honoured in development (__DEV__) only.
# - rapidapi: needs a key and a base URL (for a store build, a proxy that holds the key).
#   No ExerciseDB host is compiled into the app; the host header defaults to the base
#   URL's hostname.
# EXPO_PUBLIC_EXERCISE_REMOTE_SEARCH=off
# EXPO_PUBLIC_EXERCISE_CATALOG_BASE_URL=https://exercisedb.p.rapidapi.com
# EXPO_PUBLIC_EXERCISEDB_RAPIDAPI_KEY=
# EXPO_PUBLIC_EXERCISEDB_RAPIDAPI_HOST=

# Product analytics (PostHog, EU cloud). Project API key (phc_…) from PostHog → Settings.
# Unset = analytics off. Development builds only log events to the console unless
# EXPO_PUBLIC_ANALYTICS_IN_DEV=1. Events are anonymous (see src/analytics/analytics.ts).
EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# EXPO_PUBLIC_ANALYTICS_IN_DEV=1
